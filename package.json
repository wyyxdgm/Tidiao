    "next": "16.2.11",
    "nodemailer": "^9.0.5",
    "onnxruntime-node": "^1.29.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
