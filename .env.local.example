# 环境变量模板 —— 只列键名，不含任何真实值
# 实际值写进 .env.local（已被 .gitignore 忽略，不要提交）
# 备份位置：~/.agent-orchestrator/env-backups/

# LLM 接入（在平台 LLM 配置里也可覆盖）
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

# 服务
PORT=
NEXT_PUBLIC_APP_URL=

# 企微 intake 通道（历史留档，主链路已转 H5 门户）
WECOM_CORP_ID=
WECOM_CORP_SECRET=
WECOM_ENCODING_AES_KEY=
WECOM_CALLBACK_TOKEN=
WECOM_KF_ID=
INTAKE_PROJECT_ID=
INTAKE_WEBHOOK_SECRET=

# 邮件通知（v41）—— 任务超时通知 + 设置页「发送测试邮件」
# 🔴 真值只写进 .env.local，本文件永远只留键名
# SMTP_SECURE: true/1 = 465 隐式 TLS；其余(含空) = false，走 587 STARTTLS
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# 发信人，需与 SMTP_USER 同域
NOTIFY_FROM=
# 系统兜底收件人：用户未配置 users.notify_email 时通知发到这里
NOTIFY_FALLBACK_TO=
