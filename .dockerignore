# Build context exclusions for `docker build`.
# Goal: keep the context tarball small + prevent .env*, .git/, src/tests from
# sneaking into the image even before the builder stage's `COPY . .`.

# Version control
.git/
.gitignore

# Build outputs — rebuilt inside the builder stage, no need to ship them.
.next/
dist/
out/
build/

# Dependencies — installed by `npm ci` inside the builder stage.
# NOTE: a bare `node_modules/` pattern only matches the CONTEXT ROOT, not nested
# trees (verified with docker 28.2.2). spa/node_modules is a separate install
# tree and would otherwise be copied from the host (macOS binaries) over the
# alpine ones installed by `npm ci` — and bloats the context by ~370MB.
**/node_modules
**/dist

# SPA build output copied into public/ by `npm run build:spa`.
# The builder stage regenerates both; shipping the host's copy risks staleness.
/public/index.html
/public/assets/

# Source tests — not needed at runtime (AC8); stripped from standalone too.
*.test.ts
*.test.tsx
*.test.js
*.test.mjs
coverage/

# Secrets / local env (defense-in-depth on top of .gitignore).
.env
.env.local
.env.*.local
.env.wsl.secret
.env.wsl.secret.*

# Tooling / state / docs that should not ship.
.claude/
docs/
scripts/
data/
reports/
boards/
.tmp/
.tmp
.eslintcache
.npm/
.eslintignore
.rework-cache/

# Local artifacts that would otherwise inflate context.
*.log
*.tsbuildinfo
.DS_Store
attachments/
assets/
ao-session-*.md
ao-session-*.jsonl
decrypt-test.mjs
jingyesi-*.jpg
lushan-waterfall-*.jpg
npminstall-debug.log
# NOTE: instrumentation.ts is NOT excluded — Next.js compiles it into the
# server bundle as the startup hook (DB init / schedule runner / weixin
# worker). Excluding it from the context silently drops all three from
# container startup while the app still looks healthy.

# Docker meta — never copy back into a build.
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml